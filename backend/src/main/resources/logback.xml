<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Ktor backend logs -->
    <logger name="io.ktor" level="INFO"/>
    <logger name="io.netty" level="WARN"/>

    <!-- Silence Ktor auth/filter logs (never log Authorization header anyway). -->
    <logger name="io.ktor.server.auth" level="WARN"/>
    <logger name="io.ktor.server.plugins.callloging" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
