# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
captures/
release/
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation rule caches
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/
*.ipr
*.iws

# Keystore files
# IMPORTANT: never commit keystores or passwords
*.jks
*.keystore
!debug.keystore.example

# Google Services (e.g. APIs or FCM)
google-services.json

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Version control
vcs.xml

# OS-specific
.DS_Store
Thumbs.db

# Secrets — never commit
*.env
.env
secrets.properties
secrets/
*.secret
*.key
*.pem

# Gradle wrapper internals we never commit
gradle/gradle-daemon-jvm.properties

# CI artifacts
ci-artifacts/
